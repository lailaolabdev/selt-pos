PORT=3000
ENV=dev
# json is the lightweight default. Use mongo to reconnect MongoDB.
STORAGE_DRIVER=mongo
JSON_DB_PATH=storage/data/pos.json
MONGO_URI=mongodb://localhost:27017/pos_rfid

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_DISPLAY_NAME=Administrator
ADMIN_TOKEN_SECRET=change-this-secret
ADMIN_TOKEN_TTL_SECONDS=86400

TTS_MODEL=facebook/mms-tts-lao
TTS_LANGUAGE=lo
TTS_CACHE_DIR=storage/tts-cache
TTS_SERVICE_URL=http://localhost:8000/tts
TTS_SERVICE_MODEL=facebook
HUGGINGFACE_API_TOKEN=

PHAJAY_PAYMENT_MODE=production
PHAJAY_BASE_URL=https://payment-gateway.phajay.co
PHAJAY_PAYMENT_LINK_PATH=
PHAJAY_QR_BANK=bcel
PHAJAY_QR_PATH=
PHAJAY_SECRET_KEY=
PHAJAY_TEST_KEY=
# Use PHAJAY_SECRET_KEY with production, or PHAJAY_TEST_KEY with sandbox.
BIO_PAYMENT_BASE_URL=https://bio-payment-api.phajay.co
BIO_DEVICE_ID=
BIO_TERMINAL_KEY=
BIO_WEBHOOK_SECRET=
BIO_DEMO_MODE=false
