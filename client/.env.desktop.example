# Copy VITE values into client/.env.local before building.
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
VITE_DEVICE_ID=RPi-POS-01
VITE_ENV=production
# Set POS values in the environment used to launch Electron (not just Vite .env).
POS_API_URL=http://localhost:3000
POS_DEVICE_ID=RPi-POS-01
POS_KIOSK=1
POS_PAYMENT_ORIGINS=https://payment-link-sandbox.netlify.app,https://payment-gateway.phajay.co
POS_PRINTER_PORT=COM1
POS_PRINTER_BAUD=9600
