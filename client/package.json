{
  "name": "4b-pos-business",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc -b && vite build",
    "electron:install": "pnpm exec install-electron --no",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:dev": "node scripts/desktop-dev.cjs",
    "desktop:start": "electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:win": "npm run build && electron-builder --win nsis --x64",
    "test:printer": "node --test electron/queue.test.cjs",
    "test:desktop": "node scripts/desktop-check.cjs",
    "test:rfid": "npm --prefix ../server run build && node scripts/rfid-check.cjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-lao": "^5.3.0",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^13.1.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@locator/babel-jsx": "^0.5.1",
    "@locator/runtime": "^0.5.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "main": "electron/main.cjs",
  "description": "4B POS Business kiosk with RFID checkout and local receipt printing",
  "build": {
    "appId": "la.4b.posbusiness",
    "productName": "4B POS Business",
    "icon": "public/logo.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "!electron/**/*.test.cjs",
      "public/fonts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/bin",
        "to": "rfid",
        "filter": ["cart_scanner.exe", "cart_scanner"]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "4B POS Business",
      "uninstallDisplayName": "Uninstall 4B POS Business"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
